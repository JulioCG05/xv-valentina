---
import { CameraIcon, ImageIcon } from "@lucide/astro";
import Header2 from "../ui/Header2.astro";
import { Image } from "astro:assets";
import exp from "../../assets/explosion.png";
---

<section class="bg-[#3c0805] relative space-y-12 px-4 py-16 overflow-hidden">
  <div class="flex flex-col items-center justify-center gap-8">
    <Header2>¿Nos acompañas?</Header2>
    <p class="text-center font-serif text-footer-foreground">
      Te agradeceriamos la confirmacion de tu asistencia a partir de hoy
    </p>
    <a
      href="https://wa.link/2p92ia"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 w-full py-4 bg-footer-foreground text-gray-900 rounded-lg font-medium tracking-wider uppercase text-sm hover:bg-[#ab7b26] hover:shadow-[0_8px_20px_rgba(194,140,46,0.3)] hover:-translate-y-0.5 transition-all duration-300"
    >
      Confirmar Asistencia
    </a>
    <p class="text-center text-[10px] font-serif text-footer-foreground">
      Tienes hasta el 12 de junio o no se te tomara en cuenta.
    </p>

    <p class="text-center font-serif text-footer-foreground mt-8">
      Esperamos contar con su presencia
    </p>
    <p
      class="text-center text-footer-foreground font-brittany text-[22px] leading-normal whitespace-nowrap"
    >
      MUCHAS GRACIAS
    </p>
    <Image src={exp} alt="exp" class="w-48 md:w-64 object-contain mb-4" />
  </div>
