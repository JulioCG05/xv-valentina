---
import { ClockIcon, MapPinIcon, PartyPopperIcon } from "@lucide/astro";
import separator from "../assets/separator.svg";
import { Image } from "astro:assets";
---

<div
  class="max-w-md mx-auto bg-white/90 rounded-3xl shadow-3xl shadow-red-main p-8 md:p-10 text-center"
>
  <div
    class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#FAEFDF]/50 mb-6 border border-[#DAB87C]/30"
  >
    <PartyPopperIcon class="text-golden-main size-10" />
  </div>

  <h3 class="text-2xl md:text-3xl font-serif text-red-main mb-4 tracking-wide">
    Jardín Verali
  </h3>
  <Image src={separator} alt="" class="my-4" />

  <p
    class="text-sm font-light text-slate-500 mb-8 px-2 md:px-4 leading-relaxed"
  >
    Río San Javier 12, Acueducto de Guadalupe, Gustavo A. Madero, 07270 Ciudad
    de México, CDMX
  </p>

  <div
    class="flex items-center justify-center gap-3 mb-10 text-golden-main bg-golden-bg/50 py-3 px-6 rounded-2xl mx-auto w-fit"
  >
    <ClockIcon size={20} />
    <span class="text-lg font-medium tracking-widest uppercase">
      6:00 PM - 6:15 PM
    </span>
  </div>

  <a
    href="https://maps.google.com/?q=Jardín+Verali+Río+San+Javier+12+Acueducto+de+Guadalupe"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-2 w-full py-4 bg-red-main text-white rounded-full font-medium tracking-wider uppercase text-sm hover:bg-[#ab7b26] hover:shadow-[0_8px_20px_rgba(194,140,46,0.3)] hover:-translate-y-0.5 transition-all duration-300"
  >
    <MapPinIcon size={20} />
    Cómo llegar
  </a>
</div>
