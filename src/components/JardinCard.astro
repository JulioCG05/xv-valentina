---
import { ClockIcon, MapPinIcon } from "@lucide/astro";
import separator from "../assets/separator.svg";
import { Image } from "astro:assets";
---

<div
  class="max-w-md mx-auto bg-white/90 rounded-3xl shadow-3xl shadow-red-main p-8 md:p-10 text-center"
>
  <div
    class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#FAEFDF]/50 mb-6 border border-[#DAB87C]/30"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="128"
      height="128"
      viewBox="0 0 256 256"
      class="text-golden-main size-10"
    >
      <g fill="currentColor">
        <path
          d="M192 152a80 80 0 0 1-80 80s32-24 32-80Zm-80-80s-32 24-32 80h64c0-56-32-80-32-80"
          opacity=".2"></path>
        <path
          d="M120 64.37V16a8 8 0 0 0-16 0v48.37a88 88 0 1 0 16 0M183.54 144h-31.77c-1.51-28.36-10.79-48.36-19.44-61.06A72.16 72.16 0 0 1 183.54 144m-95.3 16h47.52c-2 33.52-16.13 52.95-23.76 61.08c-7.64-8.15-21.77-27.57-23.76-61.08m0-16c2-33.52 16.13-52.95 23.76-61.08c7.64 8.15 21.77 27.57 23.76 61.08Zm3.43-61.06C83 95.64 73.74 115.64 72.23 144H40.46a72.16 72.16 0 0 1 51.21-61.06M40.46 160h31.77c1.51 28.36 10.79 48.36 19.44 61.06A72.16 72.16 0 0 1 40.46 160m91.87 61.06c8.65-12.7 17.93-32.7 19.44-61.06h31.77a72.16 72.16 0 0 1-51.21 61.06M256 88a8 8 0 0 1-8 8h-8v8a8 8 0 0 1-16 0v-8h-8a8 8 0 0 1 0-16h8v-8a8 8 0 0 1 16 0v8h8a8 8 0 0 1 8 8M152 40a8 8 0 0 1 8-8h16V16a8 8 0 0 1 16 0v16h16a8 8 0 0 1 0 16h-16v16a8 8 0 0 1-16 0V48h-16a8 8 0 0 1-8-8"
        ></path>
      </g>
    </svg>
  </div>

  <h3 class="text-2xl md:text-3xl font-serif text-red-main mb-4 tracking-wide">
    Jardín Verali
  </h3>
  <Image src={separator} alt="" class="my-4" />

  <p class="text-sm font-light text-gray-700 mb-8 px-2 md:px-4 leading-relaxed">
    Río San Javier 12, Acueducto de Guadalupe, Gustavo A. Madero, 07270 Ciudad
    de México, CDMX
  </p>

  <div
    class="flex items-center justify-center gap-3 mb-10 text-golden-main bg-golden-bg/50 py-3 px-6 rounded-2xl mx-auto w-fit"
  >
    <ClockIcon size={20} />
    <span class="text-lg font-medium tracking-widest uppercase">
      6:00 PM - 6:15 PM
    </span>
  </div>

  <a
    href="https://maps.google.com/?q=Jardín+Verali+Río+San+Javier+12+Acueducto+de+Guadalupe"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-2 w-full py-4 bg-red-main text-white rounded-full font-medium tracking-wider uppercase text-sm hover:bg-[#ab7b26] hover:shadow-[0_8px_20px_rgba(194,140,46,0.3)] hover:-translate-y-0.5 transition-all duration-300"
  >
    <MapPinIcon size={20} />
    Cómo llegar
  </a>
</div>
