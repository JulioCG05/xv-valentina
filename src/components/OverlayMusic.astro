---
import { Image } from "astro:assets";
import sobrecito from "../assets/sobrecito.jpg";
---

<div
  id="welcome-overlay"
  class="fixed inset-0 z-50 flex flex-col items-center justify-center transition-opacity duration-1000 cursor-pointer"
>
  <Image
    src={sobrecito}
    alt="Abrir invitación"
    class="absolute inset-0 w-full h-full object-fill z-0"
  />
</div>

<script>
  const overlay = document.getElementById(
    "welcome-overlay",
  ) as HTMLDivElement | null;
  const audio = document.getElementById("bg-music") as HTMLAudioElement | null;

  if (overlay && audio) {
    overlay.addEventListener("click", () => {
      audio.volume = 0;

      audio
        .play()
        .then(() => {
          let currentVolume = 0;
          const fadeInterval = setInterval(() => {
            if (currentVolume < 0.9) {
              currentVolume += 0.1;
              audio.volume = Math.round(currentVolume * 10) / 10;
            } else {
              clearInterval(fadeInterval);
            }
          }, 200);

          overlay.classList.add("opacity-0");
          overlay.classList.add("pointer-events-none");

          setTimeout(() => {
            overlay.style.display = "none";
          }, 1000);
        })
        .catch((error: unknown) => {
          console.error("Error al reproducir el audio:", error);
        });
    });
  }
</script>

